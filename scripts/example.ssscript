print "Numbers from 1-10:"
i = 1
while i <= 10
	print i
	i = i+1
end

print "Even numbers from 1-10:"
i = 1
while i <= 10
	if i%2 == 0
		print i
	end
	i = i+1
end

print "Collatz map for n=27:"
n = 27
while n != 1
	print n
	if n%2 == 0
		n = n/2
	else
		n = (3*n+1)/2
	end
end