clear

surface = 17
width = 6
center = 12
s_start = 5
s_end = 11
d_start = 20
d_end = 26
sd_depth = 4
sd_depth_lower = 8

set_replace 0
set_material "SEMI_HEAVY_P_TYPE"
rectangle(3, 3, 3, 28, 28, surface)

set_replace 1
set_material "SEMI_HEAVY_N_TYPE"
rectangle(s_start, center-width, surface-sd_depth_lower, s_end, center+width, surface)
rectangle(d_start, center-width, surface-sd_depth_lower, d_end, center+width, surface)
rectangle(s_end, center-width, surface-sd_depth_lower, d_start, center+width, surface-sd_depth)

Sx = 0.5*(s_start+s_end)
Sy = center

Dx = 0.5*(d_start+d_end)
Dy = center

Bx = 0.5*(s_start+s_end)
By = 0.65*28 + 0.35*(center+width)

Gx = 0.5*(s_end+d_start)
Gy = center

top = 26
mid = 22

set_replace 0
set_brush_size 1

set_material "EMF"
set_emf_direction(1 0 0)
line(Sx, Sy, top, Dx, Dy, top)
set_emf_direction(0 1 0)
line(Sx, Sy, top, Bx, By, top)

set_overwrite 0
set_material "METAL_HIGH_W"
line(Bx, By, surface, Bx, By, surface)
set_material "METAL_LOW_W"
line(Sx, Sy, surface, Sx, Sy, surface)
line(Dx, Dy, surface, Dx, Dy, surface)
set_material "METAL"
line(Sx, Sy, surface, Sx, Sy, top)
line(Dx, Dy, surface, Dx, Dy, top)
line(Bx, By, surface, Bx, By, top)

set_overwrite 1
line(Sx, Sy, top, Sx, Sy, top)
line(Dx, Dy, top, Dx, Dy, top)
line(Bx, By, top, Bx, By, top)

reset